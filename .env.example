# Copy this file to .env for local overrides. The checked-in values are
# development-only and must not be reused in a shared or production system.
COMPOSE_PROJECT_NAME=nexus

# Host bindings. Compose binds these ports to loopback by default.
NEXUS_API_PORT=8000
NEXUS_DB_PORT=5432

# PostgreSQL
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus-local-only

# API runtime
NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=INFO
NEXUS_CORS_ORIGINS=http://localhost:3006,http://127.0.0.1:3006
NEXUS_REQUIRE_ACTION_APPROVAL=true
NEXUS_SIMULATION_ONLY=true
NEXUS_SEED_DEMO=true
NEXUS_SIMULATION_STEP_DELAY_SECONDS=0.2
NEXUS_DEMO_MOTION_AUTOSTART=true
NEXUS_DEMO_MOTION_FRAME_INTERVAL_SECONDS=0.25
NEXUS_DEMO_MOTION_SPEED_MULTIPLIER=1.0

# Tamper-evident audit signing. Generate a unique value for every environment and
# store it in a secret manager. The MVP has no key-rotation mechanism; add a
# persisted key identifier before rotating a live audit chain.
NEXUS_AUDIT_HMAC_KEY=replace-with-at-least-32-random-bytes

# Optional read-only OpenAI engineering review. Leave OPENAI_API_KEY blank to
# disable the endpoint without affecting API or dashboard startup.
OPENAI_API_KEY=
NEXUS_OPENAI_MODEL=gpt-5.6
NEXUS_OPENAI_TIMEOUT_SECONDS=30

# Robot link. `demo` is the reliable hackathon feed. To connect a real Boston
# Dynamics Spot for read-only telemetry and cameras, use `spot` and supply the
# robot address and a dedicated account. Never commit a real password.
NEXUS_ROBOT_ADAPTER=demo
NEXUS_SPOT_HOSTNAME=
NEXUS_SPOT_USERNAME=
NEXUS_SPOT_PASSWORD=
NEXUS_SPOT_TIMEOUT_SECONDS=8
